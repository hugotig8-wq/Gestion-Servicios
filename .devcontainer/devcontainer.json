{
  "name": "Node + PostgreSQL Manual Install",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },

  "postCreateCommand": "",
  
  "postStartCommand": "/workspaces/gestion-servicios/.runtime/pg/bin/pg_ctl -D /workspaces/gestion-servicios/.runtime/pg/data -l /workspaces/gestion-servicios/postgres.log start",

  "forwardPorts": [5432]
}
